---
/**
 * Analytics consent (MKT-007, privacy policy §13).
 * Rendered hidden; src/lib/analytics/client.ts shows it only when analytics is configured and the
 * visitor has not chosen yet, and reopens it from "Cookie settings" in the footer.
 */
import Button from "@/components/ui/button.astro";
---

<section class="consent" data-consent-banner hidden aria-label="Cookie preferences" role="region">
  <p class="consent__text">
    We count visits anonymously, without cookies. With your OK, we also use cookies to see which
    parts of the site help you most.
    <a class="consent__link" href="/privacy#13-cookies-and-similar-technologies">Privacy policy</a>
  </p>
  <div class="consent__actions">
    <Button variant="light" size="sm" arrow={false} data-consent="decline">Decline</Button>
    <Button variant="dark" size="sm" arrow={false} data-consent="accept">Accept</Button>
  </div>
</section>

<style>
  .consent {
    position: fixed;
    inset-inline: var(--space-4);
    bottom: var(--space-4);
    z-index: 60;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-line-strong);
    border-radius: 20px;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.35);
    animation: consent-in 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .consent[hidden] {
    display: none;
  }

  .consent__text {
    flex: 1 1 18rem;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .consent__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .consent__actions {
    display: flex;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent {
      animation: none;
    }
  }
</style>
