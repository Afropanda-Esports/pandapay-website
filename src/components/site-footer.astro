---
import BrandLogo from "@/components/brand-logo.astro";
import { home } from "@/content/home";
import { site, waLink } from "@/lib/site";

const { tagline, columns, smallPrint, copyright } = home.footer;

function resolveHref(href: string) {
  if (href === "whatsapp") return waLink(home.header.ctaMessage);
  if (href === "whatsapp-support")
    return waLink("Hi! I need support with an order.");
  return href;
}
---
<footer class="site-footer" data-section="footer">
  <div class="site-footer__top">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="/">
        <BrandLogo variant="wordmark" on="light" class="site-footer__logo-img" />
      </a>
      <p class="site-footer__tagline">{tagline}</p>
    </div>

    {
      columns.map((column) => (
        <div class="site-footer__col">
          <h3 class="site-footer__heading">{column.heading}</h3>
          <ul class="site-footer__list">
            {column.links.map((link) => {
              const href = resolveHref(link.href);
              const external = "external" in link && link.external;
              return (
                <li>
                  <a
                    class="site-footer__link"
                    href={href}
                    {...(external
                      ? {
                          target: "_blank",
                          rel: "noopener",
                          "data-track":
                            link.href === "whatsapp-support"
                              ? "support_click"
                              : "cta_primary",
                          "data-location": "footer",
                        }
                      : {})}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="site-footer__contact">
    <a class="site-footer__link" href={`mailto:${site.email}`}>{site.email}</a>
    <span aria-hidden="true">·</span>
    <a class="site-footer__link" href={`tel:${site.phoneTel}`}>{site.phone}</a>
    <span aria-hidden="true">·</span>
    <span>{site.address}</span>
  </div>

  <div class="site-footer__legal">
    {smallPrint.map((para) => <p>{para}</p>)}
    <p>{copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-section) var(--frame-pad) var(--space-12);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-8);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-line);
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-3);
  }

  .site-footer__logo {
    display: inline-flex;
    text-decoration: none;
  }

  .site-footer__logo-img {
    height: 32px;
    width: auto;
  }

  .site-footer__tagline {
    color: var(--color-text-muted);
    max-width: 28ch;
    font-size: var(--text-sm);
  }

  .site-footer__heading {
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .site-footer__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .site-footer__link:hover {
    color: var(--color-text);
  }

  .site-footer__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .site-footer__legal {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--line-height-body);
    max-width: 90ch;
  }

  @media (min-width: 721px) {
    .site-footer__top {
      grid-template-columns: 4fr repeat(4, 2fr);
      gap: var(--space-6);
    }
  }
</style>
