---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<div class:list={["phone", className]}>
  <div class="phone__screen"><slot /></div>
</div>

<style>
  .phone {
    width: min(100%, 22rem);
    aspect-ratio: 9 / 19.5;
    padding: 0.5rem;
    border-radius: 2.25rem;
    background: var(--color-black);
  }
  .phone__screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--color-white);
  }
  .phone__screen > :global(*) {
    position: absolute;
    inset: 0;
    height: 100%;
  }
</style>
