---
interface Props {
  id: string;
  ratio?: string;
  label?: string;
  size?: string;
  class?: string;
}
const { id, ratio = "4 / 3", label, size, class: className } = Astro.props;
---
<div
  class:list={["stub", className]}
  style={ratio === "auto" ? undefined : `aspect-ratio:${ratio}`}
  data-stub={id}
  role="img"
  aria-label={label ?? id}
>
  <span class="stub__id">{id}{size && ` · ${size}`}</span>
  {label && <span class="stub__label">{label}</span>}
</div>

<style>
  .stub {
    display: grid;
    place-content: center;
    gap: var(--space-1);
    width: 100%;
    height: 100%;
    padding: var(--space-4);
    border: 1px dashed var(--color-line-strong);
    background: repeating-linear-gradient(
      135deg,
      transparent 0 9px,
      var(--color-line) 9px 10px
    );
    color: var(--color-text-muted);
    text-align: center;
  }
  .stub__id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .stub__label {
    font-size: var(--text-sm);
    max-width: 28ch;
  }
</style>
