---
/** 24px line icons for the feature indicators. Stroke = currentColor. */
import type { FeatureIcon } from "@/content/home";

interface Props {
  name: FeatureIcon;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;

const paths: Record<FeatureIcon, string> = {
  // waving hand
