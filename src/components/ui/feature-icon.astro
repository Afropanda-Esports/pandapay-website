  // chat bubble with search
  discover: "M20 11.5a7.5 7.5 0 0 1-11.2 6.5L4 19.5l1.4-4.3A7.5 7.5 0 1 1 20 11.5ZM11.2 13.6a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8Zm1.7-.6 1.8 1.8",
  // "Aa" with a tick
  typo: "M3.5 17 7 7l3.5 10M4.7 13.6h4.6M16 17v-4.3a2.2 2.2 0 1 0-4.3.7M16 14.3c-1.1-.5-4.3-.5-4.3 1.3 0 1.7 3.4 1.8 4.3.3M17.5 7.5l1.5 1.5 3-3",
  // shelves
  shelves: "M4 20V4M20 20V4M4 9.5h16M4 15h16M7 9.5V6.5h3v3M12 9.5V5.5h3v4M7.5 15v-2.6h2.6V15M13 15v-3h3v3",
  // box with check
  stock: "M12 3 4 7v10l8 4 8-4V7l-8-4ZM4 7l8 4 8-4M12 11v10M9 15.2l1.6 1.6 3-3.2",
  // cart
  cart: "M3 4h2.2l2.2 10.5h10L19.6 7H6.2M9.5 19.2a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4ZM16.5 19.2a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4Z",
  // tag
  tag: "M3.5 12.4V4.5a1 1 0 0 1 1-1h7.9L21 12.1l-8.9 8.9-8.6-8.6ZM8 9a1.2 1.2 0 1 0 0-2.4A1.2 1.2 0 0 0 8 9ZM10.5 15.5l5-5",
  // receipt
  receipt: "M6 3h12v18l-2-1.4-2 1.4-2-1.4-2 1.4-2-1.4L6 21V3ZM9 8h6M9 11.5h6M9 15h3.5",
  // Naira sign in a circle
  naira: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM9 16.5v-9l6 9v-9M7.5 11h9M7.5 13.2h9",
  // person with shield check
  review: "M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM3 20c.6-3.3 3-5 6-5 1.2 0 2.3.3 3.2.8M18 12.5l3 1.2v2.6c0 2-1.3 3.4-3 4.2-1.7-.8-3-2.2-3-4.2v-2.6l3-1.2ZM16.7 16.5l1 1 1.7-1.8",
  // gift card
  gift: "M3.5 7.5h17v5h-17zM5 12.5h14V20H5zM12 7.5V20M12 7.5c-1-2.8-4.7-3.4-4.7-1.2 0 1.4 2.6 1.2 4.7 1.2ZM12 7.5c1-2.8 4.7-3.4 4.7-1.2 0 1.4-2.6 1.2-4.7 1.2Z",
  // route / tracking
  track: "M6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM8 17h7.5a3 3 0 0 0 0-6h-7a3 3 0 0 1 0-6H16",
  // headset
  support: "M4.5 14v-2a7.5 7.5 0 0 1 15 0v2M4.5 14a1.5 1.5 0 0 1 1.5-1.5h1V18H6a1.5 1.5 0 0 1-1.5-1.5V14ZM19.5 14a1.5 1.5 0 0 0-1.5-1.5h-1V18h1a1.5 1.5 0 0 0 1.5-1.5V14ZM17 18c0 1.7-1.6 2.5-4 2.5",
};
---

<svg
  class:list={["feature-icon", className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
