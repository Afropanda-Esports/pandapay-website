---
/**
 * Embossed pill button. One recipe, variants change tokens only.
 *
 *   <Button href={waLink(msg)} variant="primary" track="cta_primary" location="hero">Start on WhatsApp</Button>
 *   <Button variant="dark" size="sm" arrow={false} type="submit">Send</Button>
 *
 * Variant lives on `data-variant`, so scripts can switch it at runtime
 * (el.dataset.variant = "dark") and the colours transition.
 */
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "dark" | "light";
type Size = "sm" | "md" | "lg" | "xl";

interface Props extends Omit<HTMLAttributes<"a">, "type"> {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: Variant;
  size?: Size;
  arrow?: boolean;
  external?: boolean;
  track?: string;
  location?: string;
  class?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  arrow = true,
  external = false,
  track,
  location,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const linkProps = href
  ? { href, ...(external ? { target: "_blank", rel: "noopener" } : {}) }
  : { type };
---

<Tag
  class:list={["btn", className]}
  data-variant={variant}
  data-size={size}
  data-track={track}
  data-location={location}
  {...linkProps}
  {...rest}
>
  <span class="btn__label"><slot /></span>
  {
    arrow && (
      <span class="btn__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </span>
    )
  }
</Tag>

<style>
  .btn {
    /* Token defaults = primary (orange). Variants below only change these. */
    --b-base: var(--color-orange, #ff6b00);
    --b-ink: var(--color-black, #0c0c0c);
    --b-edge: #b84d00;
    --b-gloss: 0.55;
    --b-shade: rgb(120 40 0 / 0.3);
    --b-ring: var(--color-black, #0c0c0c);

    --b-h: 48px;
    --b-px: 22px;
    --b-fs: 15px;

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: var(--b-h);
    padding: 0 var(--b-px);
    border: 1px solid var(--b-edge);
    border-radius: 999px;
    background-color: var(--b-base);
    background-image: linear-gradient(
      180deg,
      rgb(255 255 255 / calc(var(--b-gloss) * 0.45)) 0%,
      rgb(255 255 255 / 0) 55%,
      rgb(0 0 0 / 0.08) 100%
    );
    color: var(--b-ink);
    font: 500 var(--b-fs) / 1 var(--font-sans);
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / var(--b-gloss)),
      inset 0 -3px 6px var(--b-shade),
      inset 0 0 0 1px rgb(255 255 255 / 0.05),
      0 1px 2px rgb(0 0 0 / 0.3),
      0 10px 18px -10px rgb(0 0 0 / 0.6);
    transition:
      transform 140ms cubic-bezier(0.3, 0.7, 0.4, 1),
      box-shadow 140ms,
      filter 200ms,
      background-color 500ms cubic-bezier(0.65, 0, 0.35, 1),
      border-color 500ms cubic-bezier(0.65, 0, 0.35, 1),
      color 500ms cubic-bezier(0.65, 0, 0.35, 1);
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  .btn:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
  }

  .btn:active,
  .btn.is-pressed {
    transform: translateY(1px);
    background-image: linear-gradient(180deg, rgb(0 0 0 / 0.12), rgb(255 255 255 / 0) 60%);
    box-shadow:
      inset 0 2px 6px var(--b-shade),
      inset 0 1px 2px rgb(0 0 0 / 0.25),
      0 1px 0 rgb(255 255 255 / 0.06);
  }

  .btn:focus-visible {
    outline: 2px solid var(--b-ring);
    outline-offset: 3px;
  }

  .btn__label {
    position: relative;
    display: inline-grid;
    overflow: hidden;
    /* room so descenders aren't clipped when labels slide */
    padding-block: 0.15em;
  }

  .btn__arrow {
    display: inline-flex;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn:hover .btn__arrow {
    transform: translateX(4px);
  }

  /* Variants: tokens only */
  .btn[data-variant="dark"] {
    --b-base: #1f1f1f;
    --b-ink: var(--color-white, #fff);
    --b-edge: #000;
    --b-gloss: 0.14;
    --b-shade: rgb(0 0 0 / 0.5);
    --b-ring: var(--color-orange, #ff6b00);
  }

  .btn[data-variant="light"] {
    --b-base: var(--color-white, #fff);
    --b-ink: var(--color-black, #0c0c0c);
    --b-edge: #bdbdbd;
    --b-gloss: 0.95;
    --b-shade: rgb(0 0 0 / 0.14);
    --b-ring: var(--color-orange, #ff6b00);
  }

  /* Sizes */
  .btn[data-size="sm"] { --b-h: 38px; --b-px: 16px; --b-fs: 13.5px; }
  .btn[data-size="lg"] { --b-h: 56px; --b-px: 26px; --b-fs: 16px; }
  .btn[data-size="xl"] { --b-h: 88px; --b-px: 48px; --b-fs: 22px; }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn__arrow {
      transition: none;
    }
  }
</style>

<script>
  // Forward cue on WhatsApp hand-off: the arrow shoots right and returns.
  // Never blocks navigation.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  document.addEventListener("click", (event) => {
    if (reduce.matches) return;
    const btn = (event.target as HTMLElement | null)?.closest<HTMLElement>(".btn");
    const arrow = btn?.querySelector<HTMLElement>(".btn__arrow");
    if (!arrow) return;
    arrow.animate(
      [
        { transform: "translateX(0)", opacity: 1 },
        { transform: "translateX(12px)", opacity: 0, offset: 0.35 },
        { transform: "translateX(-8px)", opacity: 0, offset: 0.36 },
        { transform: "translateX(0)", opacity: 1 },
      ],
      { duration: 700, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
    );
  });
</script>
