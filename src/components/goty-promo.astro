---
import { home } from "@/content/home";
import { waLink } from "@/lib/site";

const { gotyPromo: promo } = home;
const href = waLink(promo.message);
---

<div class="goty-promo" data-goty-promo>
  <button
    type="button"
    class="goty-pill"
    data-goty-pill
    data-aria-open={promo.ariaOpen}
    data-aria-close={promo.ariaClose}
    aria-expanded="false"
    aria-controls="goty-overlay"
    aria-label={promo.ariaOpen}
  >
    <span class="goty-pill__label">{promo.pillLabel}</span>
    <span class="goty-pill__dot" aria-hidden="true"></span>
    <span class="goty-pill__ping" aria-hidden="true"></span>
  </button>

  <div class="goty-overlay" id="goty-overlay" data-goty-overlay hidden>
    <div class="goty-overlay__backdrop" data-goty-backdrop data-goty-close></div>
    <div class="goty-stage">
      <button type="button" class="goty-close" data-goty-close aria-label={promo.ariaClose}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6L6 18"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
      <a
        class="goty-card"
        data-goty-card
        href={href}
        target="_blank"
        rel="noopener"
        data-track="cta_primary"
        data-location="goty-promo"
        aria-label={promo.cardAlt}
      >
        <div class="goty-card__inner" data-goty-card-inner>
          <div class="goty-card__face goty-card__back" aria-hidden="true">
            <img
              class="goty-card__mark"
              src="/brand/icon-orange.png"
              alt=""
              width="128"
              height="128"
              decoding="async"
            />
          </div>
          <div class="goty-card__face goty-card__front">
            <img
              src="/images/promo/goty-card.webp"
              alt={promo.cardAlt}
              width="1080"
              height="1350"
              decoding="async"
            />
          </div>
        </div>
      </a>
    </div>
  </div>
</div>

<script>
  import { initGotyPromo } from "@/lib/motion/goty-promo";
  document.querySelectorAll<HTMLElement>("[data-goty-promo]").forEach(initGotyPromo);
</script>

<style>
  .goty-promo {
    --goty-pill-w: 124px;
    --goty-pill-h: 24px;
    --goty-compact: 24px;
  }

  /* ---------- Trigger pill ---------- */
  .goty-pill {
    position: fixed;
    top: calc(var(--nav-top, 0.75rem) + var(--nav-h, 3.5rem) + 0.4rem);
    left: 50%;
    z-index: 90;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: var(--goty-pill-w);
    height: var(--goty-pill-h);
    padding: 0;
    border: 1px solid rgb(12 12 12 / 0.12);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.86);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.7) inset,
      0 6px 18px -10px rgb(12 12 12 / 0.35);
    color: #0c0c0c;
    cursor: pointer;
    transform: translateX(-50%);
    transition:
      width 320ms cubic-bezier(0.22, 1, 0.36, 1),
      height 320ms cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 320ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 240ms,
      box-shadow 240ms;
  }

  .goty-pill:focus-visible {
    outline: 2px solid var(--color-orange, #ff6b00);
    outline-offset: 3px;
  }

  .goty-pill__label {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
    transition: opacity 200ms, transform 200ms;
  }

  .goty-pill__dot,
  .goty-pill__ping {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-orange, #ff6b00);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms;
  }

  .goty-pill__ping {
    background: transparent;
    border: 1.5px solid var(--color-orange, #ff6b00);
  }

  /* Compact ping after scroll */
  .goty-promo[data-compact] .goty-pill {
    width: var(--goty-compact);
    height: var(--goty-compact);
  }

  .goty-promo[data-compact] .goty-pill__label {
    opacity: 0;
    transform: scale(0.6);
    pointer-events: none;
  }

  .goty-promo[data-compact] .goty-pill__dot {
    opacity: 1;
  }

  .goty-promo[data-compact] .goty-pill__ping {
    opacity: 1;
    animation: goty-ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  /* Keep pill above the overlay so it can toggle closed */
  .goty-promo[data-open] .goty-pill {
    z-index: 120;
    background: rgb(12 12 12 / 0.72);
    border-color: rgb(255 255 255 / 0.16);
    color: #fff;
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.6);
  }

  .goty-promo[data-open][data-compact] .goty-pill__dot {
    background: var(--color-orange, #ff6b00);
  }

  /* ---------- Overlay ---------- */
  .goty-overlay {
    position: fixed;
    inset: 0;
    z-index: 110;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    pointer-events: none;
  }

  /* Our display:grid would otherwise override the UA [hidden] rule */
  .goty-overlay[hidden] {
    display: none !important;
  }

  .goty-overlay:not([hidden]) {
    pointer-events: auto;
  }

  .goty-overlay__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(6 8 14 / 0.55);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    opacity: 0;
    cursor: pointer;
  }

  /* ---------- Stage + close ---------- */
  .goty-stage {
    position: relative;
    z-index: 1;
    width: min(100%, calc(min(78svh, 36rem) * 1080 / 1350));
    max-height: min(78svh, 36rem);
    aspect-ratio: 1080 / 1350;
  }

  .goty-close {
    position: absolute;
    top: 0;
    right: -4rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(12 12 12 / 0.08);
    border-radius: 50%;
    background: #fff;
    color: #0c0c0c;
    box-shadow: 0 8px 20px -10px rgb(0 0 0 / 0.45);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease, transform 220ms ease, background-color 200ms;
  }

  .goty-promo[data-open] .goty-close {
    opacity: 1;
    pointer-events: auto;
  }

  .goty-close:hover {
    background: #fff;
    transform: scale(1.05);
  }

  .goty-close:focus-visible {
    outline: 2px solid var(--color-orange, #ff6b00);
    outline-offset: 3px;
  }

  /* ---------- Flipping card ---------- */
  .goty-card {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    perspective: 1600px;
    opacity: 0;
    text-decoration: none;
    color: inherit;
    outline: none;
  }

  .goty-card:focus-visible {
    outline: 2px solid var(--color-orange, #ff6b00);
    outline-offset: 4px;
  }

  .goty-card__inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .goty-card__face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: clamp(1rem, 2.4vw, 1.5rem);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow:
      0 24px 60px -20px rgb(0 0 0 / 0.65),
      0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .goty-card__back {
    display: grid;
    place-items: center;
    background: #0c0c0c;
  }

  .goty-card__mark {
    width: 22%;
    height: auto;
    filter: drop-shadow(0 8px 16px rgb(0 0 0 / 0.45));
  }

  .goty-card__front {
    transform: rotateY(180deg);
    background: #111;
  }

  .goty-card__front img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes goty-ping {
    0% {
      transform: scale(1);
      opacity: 0.85;
    }
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .goty-pill {
      transition: none;
    }

    .goty-pill__label,
    .goty-pill__dot,
    .goty-pill__ping {
      transition: none;
    }

    .goty-promo[data-compact] .goty-pill__ping {
      animation: none;
      opacity: 0;
    }
  }
</style>
