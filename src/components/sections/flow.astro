---
/**
 * How it works: a pinned, full-screen orange scene driven by scroll.
 *
 *   left   – "Hi. Tap. Pay. Done."  The word for the current step lights up.
 *   centre – a phone showing the real WhatsApp flow, screen by screen.
 *   right  – the four steps. Active = black pill, its ring fills with your
 *            scroll progress through that step. Click to jump.
 *   behind – a soft aim-assist reticle that locks on at every step change.
 *
 * Screens: set `src` on a screen in content/home.ts to replace its stub.
 */
import Button from "@/components/ui/button.astro";
import FeatureIcon from "@/components/ui/feature-icon.astro";
import { home } from "@/content/home";
import { waLink } from "@/lib/site";

const { flow } = home;

// reticle geometry (viewBox 0 0 1000 1000, centre 500 500)
const polar = (r: number, deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [500 + r * Math.cos(a), 500 + r * Math.sin(a)] as const;
};
const arc = (r: number, from: number, to: number) => {
  const [x1, y1] = polar(r, from);
  const [x2, y2] = polar(r, to);
  return `M${x1.toFixed(1)} ${y1.toFixed(1)} A${r} ${r} 0 0 1 ${x2.toFixed(1)} ${y2.toFixed(1)}`;
};
const ticks = Array.from({ length: 72 }, (_, i) => {
  const deg = i * 5;
  const long = deg % 45 === 0;
  const [x1, y1] = polar(long ? 402 : 410, deg);
  const [x2, y2] = polar(420, deg);
  return { x1, y1, x2, y2, long };
});
const brackets = [0, 90, 180, 270].map((d) => arc(320, d + 20, d + 70));
const cross = [0, 90, 180, 270].map((d) => {
  const [x1, y1] = polar(455, d);
  const [x2, y2] = polar(495, d);
  return { x1, y1, x2, y2 };
});
---

<section
  class="flow"
  id="how-it-works"
  data-flow
  data-nav-surface
  data-tone="orange"
  aria-labelledby="flow-heading"
>
  <h2 class="sr-only" id="flow-heading">{flow.heading}</h2>
  <ol class="sr-only">
    {
      flow.steps.map((s) => (
        <li>
          <strong>{s.title}.</strong> You: {s.you} We: {s.we}
        </li>
      ))
    }
  </ol>

  <div class="flow__stage" data-flow-stage>
    <svg class="flow__aim" data-aim aria-hidden="true">
      <path data-aim-path />
      <circle data-aim-a r="3.5" />
      <circle data-aim-b r="3.5" />
    </svg>

    <p class="flow__statement" aria-hidden="true">
      {flow.steps.map((s, i) => <span class="flow__word" data-word data-active={i === 0 ? "" : undefined}>{s.word}</span>)}
    </p>

    <div class="flow__device" data-device aria-hidden="true">
      <svg class="flow__reticle" data-reticle viewBox="0 0 1000 1000">
        <g data-ret-outer>
          <circle class="ret-dash" cx="500" cy="500" r="480" />
          {cross.map((c) => <line class="ret-line ret-line--strong" x1={c.x1} y1={c.y1} x2={c.x2} y2={c.y2} />)}
        </g>
        <g data-ret-ticks>
          {ticks.map((t) => <line class:list={["ret-line", t.long && "ret-line--strong"]} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
        </g>
        <g data-ret-brackets>
          {brackets.map((d) => <path class="ret-bracket" d={d} />)}
        </g>
        <circle class="ret-ring" data-ret-ring cx="500" cy="500" r="250" />
        <circle class="ret-dash ret-dash--fine" cx="500" cy="500" r="370" />
      </svg>

      <div class="phone" data-phone>
        <div class="phone__screen">
          {
            flow.steps.map((s, si) => {
              const m = s.media;
              return (
                <div
                  class="flow-screen"
                  data-screen
                  data-step={si}
                  data-kind={m.kind}
                  data-scroll={m.scroll ?? (m.kind === "video" ? 3 : 1.4)}
                  data-first={si === 0 ? "" : undefined}
                >
                  {m.src && m.kind === "image" && <img src={m.src} alt={m.alt} decoding="async" />}
                  {m.src && m.kind === "video" && (
                    <video
                      src={m.src}
                      poster={m.poster}
                      muted
                      loop
                      playsinline
                      preload={si <= 1 ? "auto" : "metadata"}
                      aria-label={m.alt}
                    />
                  )}
                  {!m.src && (
                    <div class="flow-stub">
                      <span class="flow-stub__meta">
                        {s.title} · {m.kind}
                      </span>
                      <span class="flow-stub__icon">
                        <FeatureIcon name={s.icon} size={28} />
                      </span>
                      <span class="flow-stub__label">{m.stub}</span>
                      <span class="flow-stub__meta">
                        {m.kind === "video" ? `/videos/flow/${s.id}.mp4` : `/images/flow/${s.id}.webp`}
                      </span>
                    </div>
                  )}
                </div>
              );
            })
          }
        </div>
        <span class="phone__island"></span>
      </div>
    </div>

    <div class="flow__rail">
      <ol class="flow__steps">
        {
          flow.steps.map((s, i) => (
            <li class="flow__item" data-item data-active={i === 0 ? "" : undefined}>
              <button
                type="button"
                class="flow-step"
                data-step-btn
                aria-current={i === 0 ? "step" : undefined}
                aria-label={`Step ${i + 1}: ${s.title}`}
              >
                <span class="flow-step__icon">
                  <svg class="flow-step__ring" viewBox="0 0 44 44" aria-hidden="true">
                    <circle class="flow-step__track" cx="22" cy="22" r="20" />
                    <circle class="flow-step__progress" data-ring cx="22" cy="22" r="20" />
                  </svg>
                  <FeatureIcon name={s.icon} size={18} />
                </span>
                <span class="flow-step__title">{s.title}</span>
              </button>
              <div class="flow__detail" data-detail aria-hidden="true">
                <p>
                  <span>You</span>
                  {s.you}
                </p>
                <p>
                  <span>We</span>
                  {s.we}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <Button
        href={waLink(flow.cta.message)}
        variant="dark"
        external
        track="cta_primary"
        location="how-it-works"
        class="flow__cta"
      >
        {flow.cta.label}
      </Button>
    </div>
  </div>
</section>

<script>
  import { initFlow } from "@/lib/motion/flow";
  document.querySelectorAll<HTMLElement>("[data-flow]").forEach(initFlow);
</script>

<style>
  .flow {
    --ink: #0c0c0c;
    --deep: #e85f00;
    position: relative;
    overflow: clip;
    background: var(--color-orange, #ff6b00);
    color: var(--ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Stage (pinned) ---------- */
  .flow__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    height: 100svh;
    min-height: 38rem;
    padding: var(--nav-space, 5.5rem) clamp(1.5rem, 5vw, 5.5rem) clamp(1.5rem, 4vh, 3rem);
  }

  /* ---------- Statement ---------- */
  .flow__statement {
    position: relative;
    z-index: 2;
    display: grid;
    justify-self: start;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.4rem + 4.4vw, 7rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .flow__word {
    color: rgb(12 12 12 / 0.2);
    transition: color 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .flow__word[data-active] {
    color: var(--ink);
  }

  /* ---------- Device + reticle ---------- */
  .flow__device {
    position: relative;
    display: grid;
    place-items: center;
  }

  .flow__reticle {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 0;
    width: max(150vmin, 56rem);
    height: max(150vmin, 56rem);
    max-width: none;
    max-height: none;
    translate: -50% -50%;
    overflow: visible;
    pointer-events: none;
  }

  .ret-line,
  .ret-dash,
  .ret-ring,
  .ret-bracket {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .ret-line {
    stroke: var(--deep);
    stroke-width: 1;
  }

  .ret-line--strong {
    stroke: rgb(12 12 12 / 0.16);
    stroke-width: 1.5;
  }

  .ret-dash {
    stroke: var(--deep);
    stroke-width: 1.5;
    stroke-dasharray: 2 10;
  }

  .ret-dash--fine {
    stroke: rgb(255 255 255 / 0.22);
    stroke-width: 1;
    stroke-dasharray: 1 7;
  }

  .ret-ring {
    stroke: rgb(255 255 255 / 0.2);
    stroke-width: 1;
  }

  .ret-bracket {
    stroke: rgb(255 255 255 / 0.4);
    stroke-width: 3;
    stroke-linecap: round;
  }

  /* ---------- Phone ---------- */
  .phone {
    position: relative;
    z-index: 1;
    height: min(72svh, 46rem);
    aspect-ratio: 9 / 19.5;
    padding: 0.5rem;
    border-radius: 2.75rem;
    background: #0c0c0c;
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.14),
      0 40px 80px -30px rgb(80 30 0 / 0.55),
      0 18px 36px -18px rgb(0 0 0 / 0.4);
  }

  .phone__screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 2.25rem;
    background: #f3f1ec;
    isolation: isolate;
  }

  .phone__island {
    position: absolute;
    top: 1.05rem;
    left: 50%;
    z-index: 5;
    width: 28%;
    height: 1.4rem;
    border-radius: 999px;
    background: #0c0c0c;
    translate: -50% 0;
  }

  .flow-screen {
    position: absolute;
    inset: 0;
    background: #f3f1ec;
  }

  .flow-screen:not([data-first]) {
    visibility: hidden;
    opacity: 0;
  }

  .flow-screen img,
  .flow-screen video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* screen recordings bring their own status bar; screenshots don't, so give
     them one (dark, like WhatsApp's) and keep the island off their header */
  .flow-screen[data-kind="image"]:has(img) {
    padding-top: 2.75rem;
    background: #0b0b0b;
  }

  .flow-screen video {
    background: #0b0b0b;
  }

  .flow-stub {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    justify-items: center;
    gap: 0.875rem;
    height: 100%;
    padding: 3.25rem 1.25rem 1.5rem;
    background: repeating-linear-gradient(135deg, transparent 0 10px, rgb(12 12 12 / 0.035) 10px 11px);
    color: rgb(12 12 12 / 0.62);
    text-align: center;
  }

  .flow-stub__icon {
    display: grid;
    place-items: center;
    align-self: end;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--color-orange, #ff6b00);
    color: var(--ink);
  }

  .flow-stub__label {
    max-width: 20ch;
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .flow-stub__meta {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ---------- Rail (steps) ---------- */
  .flow__rail {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(1.5rem, 4vh, 2.5rem);
    justify-self: end;
    justify-items: start;
    width: min(100%, 24rem);
  }

  .flow__steps {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow-step {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.375rem 1.375rem 0.375rem 0.375rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgb(12 12 12 / 0.5);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 0.9rem + 1vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 450ms cubic-bezier(0.22, 1, 0.36, 1),
      color 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .flow-step:hover {
    color: var(--ink);
  }

  .flow-step:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .flow__item[data-active] .flow-step {
    background: var(--ink);
    color: #ffffff;
  }

  .flow-step__icon {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgb(12 12 12 / 0.07);
    transition: background-color 450ms;
  }

  .flow__item[data-active] .flow-step__icon {
    background: rgb(255 255 255 / 0.08);
  }

  .flow-step__ring {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }

  .flow-step__track,
  .flow-step__progress {
    fill: none;
    stroke-width: 2.5;
  }

  .flow-step__track {
    stroke: rgb(12 12 12 / 0.1);
  }

  .flow-step__progress {
    stroke: rgb(12 12 12 / 0.45);
    stroke-linecap: round;
    stroke-dasharray: 125.66;
    stroke-dashoffset: 125.66;
  }

  .flow__item[data-active] .flow-step__track {
    stroke: rgb(255 255 255 / 0.14);
  }

  .flow__item[data-active] .flow-step__progress {
    stroke: var(--color-orange, #ff6b00);
  }

  .flow-step__title {
    white-space: nowrap;
  }

  .flow__detail {
    height: 0;
    overflow: hidden;
  }

  .flow__item[data-active] .flow__detail {
    height: auto;
  }

  .flow__detail p {
    display: flex;
    gap: 0.625rem;
    max-width: 30ch;
    margin: 0;
    padding-left: 4rem;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .flow__detail p:first-child {
    padding-top: 0.75rem;
  }

  .flow__detail p:last-child {
    padding-top: 0.375rem;
    padding-bottom: 0.5rem;
  }

  .flow__detail span {
    flex: none;
    width: 2rem;
    padding-top: 0.2em;
    color: rgb(12 12 12 / 0.55);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ---------- Aim line (desktop) ---------- */
  .flow__aim {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .flow__aim path {
    fill: none;
    stroke: rgb(12 12 12 / 0.35);
    stroke-width: 1.25;
    stroke-dasharray: 3 6;
  }

  .flow__aim circle {
    fill: var(--ink);
  }

  /* ---------- Narrower desktop ---------- */
  @media (max-width: 1180px) and (min-width: 900px) {
    .flow__stage {
      grid-template-columns: minmax(0, 0.75fr) auto minmax(0, 1.25fr);
      gap: 1.5rem;
      padding-inline: 1.5rem;
    }

    .flow__statement {
      font-size: clamp(2.5rem, 0.5rem + 4.4vw, 4rem);
    }

    .flow-step {
      font-size: 1.25rem;
    }

    .phone {
      height: min(66svh, 40rem);
    }

    .flow__detail p {
      max-width: none;
      padding-left: 3.625rem;
    }
  }

  /* ---------- Mobile / tablet portrait ---------- */
  @media (max-width: 899px) {
    .flow__stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto;
      justify-items: center;
      gap: 1rem;
      min-height: 34rem;
      padding: calc(var(--nav-space, 5rem) + 0.75rem) 1rem 1.25rem;
    }

    .flow__statement {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      justify-self: center;
      gap: 0 0.3em;
      font-size: clamp(1.75rem, 1rem + 4vw, 2.75rem);
    }

    .flow__device {
      height: 100%;
      min-height: 0;
    }

    .phone {
      height: min(100%, 34rem);
      max-height: 58svh;
      padding: 0.375rem;
      border-radius: 2rem;
    }

    .phone__screen {
      border-radius: 1.65rem;
    }

    .phone__island {
      top: 0.75rem;
      height: 1rem;
    }

    .flow-stub {
      padding: 2.5rem 0.875rem 1rem;
    }

    .flow-stub__label {
      font-size: 0.82rem;
    }

    .flow__rail {
      justify-self: center;
      justify-items: center;
      width: auto;
    }

    .flow__steps {
      display: flex;
      gap: 0.375rem;
    }

    .flow-step {
      padding: 0.25rem;
      gap: 0;
      font-size: 1rem;
      background: rgb(12 12 12 / 0.06);
    }

    .flow-step__title {
      max-width: 0;
      overflow: hidden;
      transition:
        max-width 500ms cubic-bezier(0.22, 1, 0.36, 1),
        padding 500ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .flow__item[data-active] .flow-step__title {
      max-width: 11rem;
      padding: 0 0.875rem 0 0.625rem;
    }

    .flow__detail,
    .flow__aim,
    .flow__rail :global(.flow__cta) {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .flow-step__icon {
      width: 2.5rem;
      height: 2.5rem;
    }

    .flow__item[data-active] .flow-step__title {
      padding: 0 0.625rem 0 0.375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__word,
    .flow-step,
    .flow-step__title {
      transition: none;
    }
  }
</style>
