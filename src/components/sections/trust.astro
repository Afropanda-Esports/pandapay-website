---
import Section from "@/components/frame/section.astro";
import Cells from "@/components/frame/cells.astro";
import ButtonLink from "@/components/ui/button-link.astro";
import Stub from "@/components/ui/stub.astro";
import { home } from "@/content/home";
import { waLink } from "@/lib/site";

const { trust } = home;
const claims = trust.items.filter((item) => !("testimonials" in item && item.testimonials));
const testimonials = trust.items.find(
  (item) => "testimonials" in item && item.testimonials,
);
---
<Section id="trust" aria-labelledby="trust-heading" class="trust">
  <div class="trust__grid">
    <div class="trust__intro">
      <h2 id="trust-heading" class="trust__heading" data-reveal>
        {trust.heading}
      </h2>
    </div>

    <div class="trust__claims">
      <Cells cols={2} tabletCols={2} class="trust__cells">
        {
          claims.map((item) => (
            <article class="trust-card" data-reveal>
              <h3 class="trust-card__title">{item.title}</h3>
              <p class="trust-card__body">
                {item.body}
                {"linkHref" in item && item.linkHref && (
                  <>
                    {" "}
                    <a class="trust-card__link" href={item.linkHref}>
                      {item.linkLabel}
                    </a>
                  </>
                )}
              </p>
            </article>
          ))
        }
        {
          testimonials && (
            <article class="trust-card trust-card--testimonials" data-reveal>
              <h3 class="trust-card__title">{testimonials.title}</h3>
              <Stub
                id="trust-testimonials"
                ratio="16 / 9"
                label="Approved testimonials and order figures"
              />
            </article>
          )
        }
      </Cells>
    </div>
  </div>

  <div class="trust__support">
    <p data-reveal>{trust.support}</p>
    <ButtonLink
      href={waLink(trust.supportMessage)}
      variant="secondary"
      track="support_click"
      location="trust"
      external
    >
      {trust.supportCta}
    </ButtonLink>
  </div>
</Section>

<style>
  .trust {
    padding-bottom: 0;
  }

  .trust__grid {
    display: grid;
    gap: var(--space-10);
    margin-bottom: var(--space-8);
  }

  .trust__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.03em;
    max-width: 14ch;
  }

  .trust-card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .trust-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
  }

  .trust-card__body {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 40ch;
    font-size: var(--text-sm);
  }

  .trust-card__link {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .trust__support {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-inline: calc(var(--frame-pad) * -1);
    padding: var(--space-8) var(--frame-pad);
    border-top: 1px solid var(--color-line);
  }

  .trust__support p {
    margin: 0;
    max-width: 48ch;
    font-size: var(--text-lg);
    font-family: var(--font-display);
    font-weight: var(--font-weight-medium);
  }

  @media (min-width: 1024px) {
    .trust__grid {
      grid-template-columns: 4fr 8fr;
      gap: var(--space-8);
      align-items: start;
    }

    .trust__intro {
      position: sticky;
      top: calc(var(--header-h) + var(--space-8));
    }

    .trust__claims :global(.cells) {
      margin-inline: 0;
      border-block: 0;
    }
  }
</style>
