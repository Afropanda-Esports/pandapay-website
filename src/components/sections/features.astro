---
/**
 * Living bento: five theme tiles, all visible at once.
 * Each tile cycles its own features on its own clock (staggered so tiles never
 * change together). The round indicator shows the current feature's icon inside
 * a timer ring; clicking it moves that tile on.
 *
 * Media: set `src` in content/home.ts to replace a stub with the real image/video.
 */
import FeatureIcon from "@/components/ui/feature-icon.astro";
import { home } from "@/content/home";

const { features } = home;
---

<section class="features" id="features" data-features aria-labelledby="features-heading">
  <header class="features__head">
    <h2 class="features__heading" id="features-heading" data-features-split>{features.heading}</h2>
    <p class="features__intro" data-features-split>{features.intro}</p>
  </header>

  <div class="bento">
    {
      features.tiles.map((tile, t) => (
        <article
          class="bento-tile"
          data-tile
          data-tile-index={t}
          data-surface={tile.surface}
          data-transition={tile.transition}
          data-duration={tile.duration}
          style={`grid-area:${tile.id}`}
          aria-labelledby={`tile-${tile.id}`}
        >
          {/* Full content for screen readers; the animated layer below is decorative */}
          <h3 class="sr-only" id={`tile-${tile.id}`}>{tile.theme}</h3>
          <ul class="sr-only">
            {tile.features.map((f) => (
              <li>
                <strong>{f.title}</strong> {f.line}
              </li>
            ))}
          </ul>

          <div class="bento-tile__head" aria-hidden="true">
            <span class="bento-tile__theme">{tile.theme}</span>
          </div>

          <button
            type="button"
            class="bento-ind"
            data-ind
            aria-label={`Show next: ${tile.features[1 % tile.features.length]!.title}`}
          >
            <svg class="bento-ind__ring" viewBox="0 0 48 48" aria-hidden="true">
              <circle class="bento-ind__track" cx="24" cy="24" r="21" />
              <circle class="bento-ind__progress" data-ring cx="24" cy="24" r="21" />
            </svg>
            <span class="bento-ind__icons" aria-hidden="true">
              {tile.features.map((f, i) => (
                <span class="bento-ind__icon" data-ind-icon data-index={i}>
                  <FeatureIcon name={f.icon} size={18} />
                </span>
              ))}
            </span>
          </button>

          <div class="bento-tile__media" aria-hidden="true">
            {tile.features.map((f, i) => (
              <div class="bento-media" data-media data-index={i} data-kind={f.media.kind}>
                {f.media.src ? (
                  f.media.kind === "video" ? (
                    <video
                      src={f.media.src}
                      poster={f.media.poster}
                      muted
                      loop
                      playsinline
                      preload={i === 0 ? "auto" : "metadata"}
                    />
                  ) : (
                    <img src={f.media.src} alt={f.media.alt} loading="lazy" decoding="async" />
                  )
                ) : (
                  <div class="bento-stub">
                    <span class="bento-stub__kind">{f.media.kind === "video" ? "Video" : "Image"} · {f.id}</span>
                    <span class="bento-stub__label">{f.media.stub}</span>
                    <span class="bento-stub__size">{f.media.size}</span>
                  </div>
                )}
              </div>
            ))}
          </div>

          <div class="bento-tile__copy" aria-hidden="true">
            {tile.features.map((f, i) => (
              <div class="bento-copy" data-copy data-index={i}>
                <p class="bento-copy__title" data-split>{f.title}</p>
                <p class="bento-copy__line" data-split>{f.line}</p>
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { initFeatures } from "@/lib/motion/features";
  document.querySelectorAll<HTMLElement>("[data-features]").forEach(initFeatures);
</script>

<style>
  .features {
    padding: clamp(4rem, 9vw, 8rem) var(--hero-pad, clamp(0.5rem, 1.6vw, 1.5rem));
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Heading ---------- */
  .features__head {
    display: grid;
    gap: 1rem;
    max-width: 90rem;
    margin: 0 auto clamp(2rem, 4vw, 3.5rem);
    padding-inline: clamp(1rem, 1.8vw, 1.5rem); /* lines up with the tile copy */
  }

  .features__heading {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.3rem + 3.6vw, 4.5rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .features__intro {
    margin: 0;
    max-width: 44ch;
    color: rgb(12 12 12 / 0.72);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    font-weight: 300;
    line-height: 1.55;
  }

  @media (min-width: 1024px) {
    .features__head {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }
  }

  .features :global(.line) {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .features :global(.line__inner) {
    display: inline-block;
  }

  /* ---------- Grid ---------- */
  .bento {
    display: grid;
    gap: clamp(0.5rem, 1vw, 0.875rem);
    max-width: 90rem;
    margin-inline: auto;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: minmax(30rem, 36rem) minmax(28rem, 33rem);
    grid-template-areas:
      "texting texting texting texting texting texting texting finding finding finding finding finding"
      "store store store store store paying paying paying after after after after";
  }

  /* ---------- Tile ---------- */
  .bento-tile {
    --tile-bg: #f3f1ec;
    --tile-ink: #0c0c0c;
    --tile-muted: rgb(12 12 12 / 0.7);
    --tile-well: #e8e5df;
    --ind-bg: #ffffff;
    --ind-edge: rgb(12 12 12 / 0.1);
    --ring-track: rgb(12 12 12 / 0.1);
    --ring: var(--color-orange, #ff6b00);

    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: clamp(0.875rem, 1.6vw, 1.25rem);
    min-width: 0;
    padding: clamp(1rem, 1.8vw, 1.5rem);
    overflow: hidden;
    border-radius: clamp(1.5rem, 2.4vw, 2rem);
    background: var(--tile-bg);
    color: var(--tile-ink);
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bento-tile[data-surface="house"] {
    --tile-bg: #0c0c0c;
    --tile-ink: #ffffff;
    --tile-muted: rgb(255 255 255 / 0.72);
    --tile-well: #1c1c1c;
    --ind-bg: #1c1c1c;
    --ind-edge: rgb(255 255 255 / 0.12);
    --ring-track: rgb(255 255 255 / 0.14);
  }

  .bento-tile[data-surface="signal"] {
    --tile-bg: var(--color-orange, #ff6b00);
    --tile-ink: #0c0c0c;
    --tile-muted: rgb(12 12 12 / 0.76);
    --tile-well: #e85f00;
    --ind-bg: #0c0c0c;
    --ind-edge: #000;
    --ring-track: rgb(255 255 255 / 0.16);
    --ring: #ffffff;
  }

  .bento-tile__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding-right: 3.75rem; /* room for the indicator */
  }

  .bento-tile__theme {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.125rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* ---------- Indicator ---------- */
  .bento-ind {
    position: absolute;
    top: clamp(1rem, 1.8vw, 1.5rem);
    right: clamp(1rem, 1.8vw, 1.5rem);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid var(--ind-edge);
    border-radius: 50%;
    background: var(--ind-bg);
    color: var(--tile-ink);
    cursor: pointer;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 6px 16px -8px rgb(0 0 0 / 0.5);
    transition: transform 140ms cubic-bezier(0.3, 0.7, 0.4, 1);
  }

  .bento-tile[data-surface="signal"] .bento-ind {
    color: #ffffff;
  }

  .bento-ind:hover {
    transform: translateY(-1px);
  }

  .bento-ind:active {
    transform: translateY(1px) scale(0.96);
  }

  .bento-ind:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .bento-ind__ring {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    transform: rotate(-90deg);
    pointer-events: none;
  }

  .bento-ind__track,
  .bento-ind__progress {
    fill: none;
    stroke-width: 2.5;
  }

  .bento-ind__track {
    stroke: var(--ring-track);
  }

  .bento-ind__progress {
    stroke: var(--ring);
    stroke-linecap: round;
    stroke-dasharray: 131.95;
    stroke-dashoffset: 131.95;
  }

  .bento-ind__icons {
    display: grid;
  }

  .bento-ind__icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
  }

  .bento-ind__icon:not([data-index="0"]) {
    opacity: 0;
    visibility: hidden;
  }

  /* ---------- Media ---------- */
  .bento-tile__media {
    position: relative;
    min-height: 10rem;
    overflow: hidden;
    border-radius: clamp(1rem, 1.6vw, 1.25rem);
    background: var(--tile-well);
    isolation: isolate;
  }

  .bento-media {
    position: absolute;
    inset: 0;
    will-change: transform, opacity, clip-path;
  }

  .bento-media:not([data-index="0"]) {
    opacity: 0;
    visibility: hidden;
  }

  .bento-media img,
  .bento-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bento-stub {
    display: grid;
    place-content: center;
    gap: 0.4rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px dashed color-mix(in srgb, currentColor 30%, transparent);
    border-radius: inherit;
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, color-mix(in srgb, currentColor 6%, transparent) 10px 11px),
      var(--tile-well);
    color: var(--tile-muted);
    text-align: center;
  }

  .bento-stub__kind,
  .bento-stub__size {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bento-stub__label {
    max-width: 30ch;
    margin-inline: auto;
    color: var(--tile-ink);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  /* ---------- Copy ---------- */
  .bento-tile__copy {
    display: grid;
  }

  .bento-copy {
    grid-area: 1 / 1;
    display: grid;
    gap: 0.4rem;
    align-content: end;
  }

  .bento-copy:not([data-index="0"]) {
    visibility: hidden;
  }

  .bento-copy__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .bento-copy__line {
    margin: 0;
    max-width: 44ch;
    color: var(--tile-muted);
    font-size: clamp(0.9rem, 0.87rem + 0.15vw, 1rem);
    line-height: 1.5;
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1100px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: minmax(28rem, auto);
      grid-template-areas:
        "texting texting"
        "finding store"
        "paying after";
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 680px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
      grid-template-areas: "texting" "finding" "store" "paying" "after";
    }

    .bento-tile__media {
      aspect-ratio: 4 / 3;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-tile,
    .bento-ind {
      transition: none;
    }
  }
</style>
