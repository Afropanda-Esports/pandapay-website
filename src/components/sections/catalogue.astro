---
import Section from "@/components/frame/section.astro";
import SectionHead from "@/components/frame/section-head.astro";
import Cells from "@/components/frame/cells.astro";
import Stub from "@/components/ui/stub.astro";
import Tag from "@/components/ui/tag.astro";
import { home } from "@/content/home";
import { waLink } from "@/lib/site";

const { catalogue } = home;
const live = catalogue.products.filter((p) => p.status === "live");
const soon = catalogue.products.filter((p) => p.status === "soon");
---
<Section id="products" aria-labelledby="catalogue-heading" class="catalogue">
  <SectionHead
    id="catalogue-heading"
    heading={catalogue.heading}
    intro={catalogue.intro}
  />

  <Cells cols={2} tabletCols={2} class="catalogue__live">
    {
      live.map((product) => (
        <article class="product" data-reveal>
          <div class="product__art">
            {product.art && product.art !== "stub" ? (
              <img
                class="product__image"
                src={product.art}
                alt=""
                width="600"
                height="800"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Stub
                id={product.stubId ?? "product-ps-plus"}
                ratio="3 / 4"
                size="600×800"
                label={product.stubLabel}
              />
            )}
          </div>
          <h3 class="product__name">{product.name}</h3>
          <p class="product__line">{product.line}</p>
          <a
            class="product__link"
            href={waLink(product.message)}
            data-track="cta_product"
            data-product={product.slug}
            target="_blank"
            rel="noopener"
          >
            {catalogue.buyLabel}
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </Cells>

  <Cells cols={5} tabletCols={2} class="catalogue__soon">
    {
      soon.map((product) => (
        <div class="product-soon" data-reveal>
          <h3 class="product-soon__name">{product.name}</h3>
          <p class="product-soon__line">{product.line}</p>
          <Tag>{catalogue.comingSoonLabel}</Tag>
        </div>
      ))
    }
    <div class="cells__filler" aria-hidden="true"></div>
  </Cells>

  <div class="catalogue__footnote">
    <p>{catalogue.footnote}</p>
  </div>
</Section>

<style>
  .catalogue {
    padding-bottom: 0;
  }

  .catalogue :global(.cells.catalogue__soon) {
    border-block-end: 0;
  }

  .product {
    position: relative;
    display: grid;
    gap: var(--space-4);
    align-content: start;
    transition: background var(--duration-fast) var(--ease-standard);
  }

  .product:hover,
  .product:focus-within {
    background: var(--color-wash);
    box-shadow: inset 0 2px 0 var(--color-orange);
  }

  .product__art {
    overflow: hidden;
    max-height: 480px;
    aspect-ratio: 3 / 4;
  }

  .product__art :global(img),
  .product__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--duration-slow) var(--ease-enter);
  }

  .product:hover .product__image,
  .product:focus-within .product__image {
    transform: scale(1.02);
  }

  .product__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
  }

  .product__line {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 36ch;
  }

  .product__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .product__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .product__link span {
    transition: transform var(--duration-normal) var(--ease-enter);
  }

  .product:hover .product__link span,
  .product:focus-within .product__link span {
    transform: translateX(4px);
  }

  /* Stretch hit area over the whole card */
  .product__link::after {
    inset: calc(var(--space-8) * -1) calc(var(--frame-pad) * -1);
  }

  .product-soon {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    opacity: 0.6;
  }

  .product-soon__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
  }

  .product-soon__line {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .cells__filler {
    display: none;
  }

  .catalogue__footnote {
    margin-inline: calc(var(--frame-pad) * -1);
    padding: var(--space-6) var(--frame-pad);
    border-top: 1px solid var(--color-line);
  }

  .catalogue__footnote p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    max-width: 70ch;
  }

  @media (min-width: 721px) and (max-width: 1023px) {
    .cells__filler {
      display: block;
    }
  }
</style>

