---
import Section from "@/components/frame/section.astro";
import SectionHead from "@/components/frame/section-head.astro";
import ButtonLink from "@/components/ui/button-link.astro";
import Phone from "@/components/ui/phone.astro";
import Stub from "@/components/ui/stub.astro";
import Tag from "@/components/ui/tag.astro";
import { home } from "@/content/home";
import { waLink } from "@/lib/site";

const { flow } = home;
---
<Section
  id="how-it-works"
  aria-labelledby="flow-heading"
  class="flow"
  data-flow
>
  <SectionHead
    id="flow-heading"
    heading={flow.heading}
    intro={flow.intro}
  />

  <div class="flow__stage" data-flow-stage>
    <div class="flow__tabs" role="tablist" aria-label="Service categories">
      {
        flow.services.map((service, index) => (
          <button
            class="flow__tab"
            type="button"
            role="tab"
            id={`flow-tab-${service.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`flow-panel-${service.id}`}
            data-service={service.id}
            data-track="category_interaction"
            tabindex={index === 0 ? 0 : -1}
          >
            <span>{service.label}</span>
            {service.soon && <Tag>Soon</Tag>}
          </button>
        ))
      }
    </div>

    <div class="flow__body">
      <div class="flow__steps-wrap">
        <span class="flow__rail" aria-hidden="true">
          <span class="flow__rail-fill" data-rail-fill></span>
        </span>
        <div class="flow__progress" aria-hidden="true" data-progress>
          {
            flow.steps.map((_, i) => (
              <span class="flow__progress-seg" data-progress-seg={i}></span>
            ))
          }
        </div>
        <ol class="flow__steps">
          {
            flow.steps.map((step, index) => (
              <li
                class="flow__step"
                data-step={index}
                {...(index === 0 ? { "data-active": "" } : {})}
              >
                <button type="button" class="flow__step-btn">
                  <span class="flow__step-copy">
                    <span class="flow__step-title">{step.title}</span>
                    <span class="flow__step-line">{step.line}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="flow__device">
        <Phone>
          {
            flow.services.map((service, sIndex) => (
              <div
                data-screens={service.id}
                id={`flow-panel-${service.id}`}
                role="tabpanel"
                aria-labelledby={`flow-tab-${service.id}`}
                hidden={sIndex !== 0}
              >
                {flow.steps.map((step, index) => {
                  const nn = String(index + 1).padStart(2, "0");
                  return (
                    <div
                      class="flow__screen"
                      data-screen
                      data-active={index === 0 ? "" : undefined}
                      style={index === 0 ? undefined : "opacity:0;visibility:hidden"}
                    >
                      <Stub
                        id={`flow-playstation-${nn}`}
                        ratio="auto"
                        size="1170×2532"
                        label={`${step.title} — ${service.example}`}
                      />
                    </div>
                  );
                })}
              </div>
            ))
          }
        </Phone>
      </div>
    </div>
  </div>

  <div class="flow__closing">
    <p data-reveal>{flow.closing}</p>
    <ButtonLink
      href={waLink(flow.ctaMessage)}
      track="cta_primary"
      location="flow"
      external
    >
      {flow.cta}
    </ButtonLink>
  </div>
</Section>

<style>
  .flow {
    padding-bottom: 0;
  }

  .flow__stage {
    display: grid;
    gap: 0;
  }

  .flow__tabs {
    display: flex;
    gap: 1px;
    margin-inline: calc(var(--frame-pad) * -1);
    overflow-x: auto;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    scrollbar-width: none;
  }

  .flow__tabs::-webkit-scrollbar {
    display: none;
  }

  .flow__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    flex: 1 0 auto;
    min-height: 3.5rem;
    min-width: 7.5rem;
    padding-inline: var(--space-4);
    border: 0;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
  }

  .flow__tab[aria-selected="true"] {
    color: var(--color-text);
    box-shadow: inset 0 -2px 0 var(--color-orange);
  }

  .flow__body {
    display: grid;
    gap: var(--space-8);
    padding-top: var(--space-8);
  }

  .flow__steps-wrap {
    position: relative;
    display: grid;
  }

  .flow__steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow__rail {
    display: none;
  }

  .flow__progress {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 2px;
    margin-bottom: var(--space-4);
  }

  .flow__progress-seg {
    height: 2px;
    background: var(--color-line);
  }

  .flow__progress-seg[data-active] {
    background: var(--color-orange);
  }

  .flow__step {
    display: none;
    border-bottom: 1px solid var(--color-line);
    opacity: 0.45;
  }

  .flow__step[data-active] {
    display: block;
    opacity: 1;
  }

  .flow--reduced .flow__step {
    display: block;
    opacity: 1;
  }

  .flow__step-btn {
    display: block;
    width: 100%;
    min-height: 4rem;
    padding: var(--space-4) 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
  }

  .flow__step-copy {
    display: grid;
    gap: var(--space-1);
  }

  .flow__step-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
  }

  .flow__step-line {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height var(--duration-normal) var(--ease-standard),
      opacity var(--duration-normal) var(--ease-standard);
  }

  .flow__step[data-active] .flow__step-line {
    max-height: 6rem;
    opacity: 1;
  }

  .flow--reduced .flow__step-line {
    max-height: none;
    opacity: 1;
  }

  .flow__device {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    order: -1;
  }

  .flow__device :global(.phone) {
    width: min(100%, 16rem);
    max-height: 62vh;
  }

  .flow__screen {
    position: absolute;
    inset: 0;
  }

  .flow__closing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-inline: calc(var(--frame-pad) * -1);
    margin-top: var(--space-10);
    padding: var(--space-8) var(--frame-pad);
    border-top: 1px solid var(--color-line);
  }

  .flow__closing p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    max-width: 20ch;
  }

  @media (min-width: 721px) {
    .flow__tabs {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      overflow: visible;
    }

    .flow__tab {
      min-width: 0;
    }

    .flow__body {
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      margin-inline: calc(var(--frame-pad) * -1);
      background: var(--color-line);
      border: 1px solid var(--color-line);
      border-top: 0;
      padding: 0;
    }

    .flow__steps-wrap,
    .flow__device {
      background: var(--color-surface);
      padding: var(--space-8) var(--frame-pad);
      order: 0;
    }

    .flow__step {
      display: block;
    }

    .flow__rail {
      display: block;
      position: absolute;
      left: 0.7rem;
      top: 0.5rem;
      bottom: 0.5rem;
      width: 1px;
      background: var(--color-line);
    }

    .flow__rail-fill {
      display: block;
      width: 100%;
      height: 100%;
      background: var(--color-orange);
      transform-origin: top;
      transform: scaleY(0);
    }

    .flow__progress {
      display: none;
    }

    .flow__step-btn {
      padding-left: var(--space-6);
    }

    .flow__device :global(.phone) {
      width: min(100%, 20rem);
      max-height: none;
    }

    .flow--reduced .flow__step {
      opacity: 1;
    }
  }
</style>

