---
import BrandLogo from "@/components/brand-logo.astro";
import Section from "@/components/frame/section.astro";
import ButtonLink from "@/components/ui/button-link.astro";
import { home } from "@/content/home";
import { site, waLink } from "@/lib/site";

const { finalCta } = home;
---
<Section id="final-cta" tone="dark" class="final-cta" aria-labelledby="final-heading">
  <div class="final-cta__grid">
    <div class="final-cta__copy">
      <h2 id="final-heading" class="final-cta__heading" data-final-headline>
        {finalCta.heading}
      </h2>
      <p class="final-cta__subhead" data-reveal>{finalCta.subhead}</p>
      <div class="final-cta__actions" data-reveal>
        <ButtonLink
          href={waLink(finalCta.message)}
          track="cta_primary"
          location="final"
          external
        >
          {finalCta.primaryCta}
        </ButtonLink>
        <a class="final-cta__secondary" href="#faq">{finalCta.secondaryCta}</a>
      </div>
    </div>

    <div class="final-cta__mark" data-final-mark aria-hidden="true">
      <BrandLogo variant="mark" decorative class="final-cta__icon" />
      <span class="visually-hidden">{site.name}</span>
    </div>
  </div>
</Section>

<style>
  .final-cta__grid {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }

  .final-cta__copy {
    display: grid;
    gap: var(--space-6);
  }

  .final-cta__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: -0.04em;
    max-width: 14ch;
  }

  .final-cta__subhead {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 40ch;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-light);
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .final-cta__secondary {
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    box-shadow: inset 0 -1px 0 var(--color-line);
  }

  .final-cta__secondary:hover {
    color: var(--color-white);
  }

  .final-cta__mark {
    display: grid;
    place-items: center;
  }

  .final-cta__icon {
    width: min(100%, 220px);
    height: auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 1024px) {
    .final-cta__grid {
      grid-template-columns: 8fr 4fr;
      gap: var(--space-8);
    }
  }
</style>
