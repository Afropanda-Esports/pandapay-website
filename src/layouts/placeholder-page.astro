---
import BaseLayout from "@/layouts/base-layout.astro";
import Frame from "@/components/frame/frame.astro";
import Section from "@/components/frame/section.astro";
import SiteHeader from "@/components/site-header.astro";
import SiteFooter from "@/components/site-footer.astro";

interface Props {
  title: string;
  heading: string;
}
const { title, heading } = Astro.props;
---
<BaseLayout title={`${title} · Panda Pay`}>
  <Frame>
    <SiteHeader />
    <main>
      <Section id="placeholder" aria-labelledby="placeholder-heading" marked={false}>
        <h1 id="placeholder-heading" class="placeholder__title">{heading}</h1>
        <p class="placeholder__body">Coming soon.</p>
      </Section>
    </main>
    <SiteFooter />
  </Frame>
</BaseLayout>

<style>
  .placeholder__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }
  .placeholder__body {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>
